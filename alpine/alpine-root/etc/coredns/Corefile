onion {
  loop

  bind 127.0.0.1 ::1

  #log
  #errors

  forward onion dns://127.0.0.1:{$TOR_ONION_DNS_UDP_PORT} {
    prefer_udp
    policy sequential
    health_check 1s
    failfast_all_unhealthy_upstreams
    failover SERVFAIL REFUSED
  }
}

. {
  loop

  bind 127.0.0.1 ::1

  #log
  #errors

  hosts {$DNS_BANLIST} {
    reload 1h
    fallthrough
  }

  cache {
    prefetch 4096 20s
    serve_stale 48h
    servfail 1s
  }

  # disable ipv6
  #template IN AAAA {
  #  rcode NOERROR
  #}

  forward . dns://127.0.0.1:{$EXTERNAL_TOR_DNS_LOCAL_TCP_PORT} {
    force_tcp
    policy sequential
    health_check 1s
    failfast_all_unhealthy_upstreams
    failover SERVFAIL REFUSED
  }

