#!/usr/bin/env bash

source /etc/profile.d/99local.sh

nft add table inet filter || :
nft add chain inet filter input '{ type filter hook input priority 0; policy accept; }' || :
nft add chain inet filter output '{ type filter hook output priority 0; policy accept; }' || :
nft add chain inet filter nat_output '{ type nat hook output priority -100; policy accept; }' || :

[ -f "${LOCAL_BANLIST}" ] || touch "${LOCAL_BANLIST}"
nft add set inet filter ban4 '{ type ipv4_addr; flags interval; }'
nft add set inet filter ban6 '{ type ipv6_addr; flags interval; }'
nft add rule inet filter input ip saddr @ban4 drop
nft add rule inet filter input ip6 saddr @ban6 drop

[ -f /usr/sbin/sshd ] && {
  nft add set inet filter ssh_allow4 '{ type ipv4_addr; flags interval; }'
  nft add set inet filter ssh_allow6 '{ type ipv6_addr; flags interval; }'
  nft add rule inet filter input iifname "${WAN_IFACE}" ip saddr @ssh_allow4 meta l4proto '{ tcp, udp }' th dport "${SSH_PORT}" accept
  nft add rule inet filter input iifname "${WAN_IFACE}" ip6 saddr @ssh_allow6 meta l4proto '{ tcp, udp }' th dport "${SSH_PORT}" accept
}

[ -f /usr/bin/tor ] && {
  VADDR4=$(grep VirtualAddrNetworkIPv4 /etc/tor/torrc | awk '{print $2}')
  VADDR6=$(grep VirtualAddrNetworkIPv6 /etc/tor/torrc | awk '{print $2}' | sed 's!\[!!;s!\]!!')

  [ -n "${VADDR4}" ] && nft add rule inet filter nat_output ip daddr "${VADDR4}" tcp redirect to :9052
  [ -n "${VADDR6}" ] && nft add rule inet filter nat_output ip6 daddr "${VADDR6}" tcp redirect to :9052
}

nft add rule inet filter nat_output ip daddr '{ 9.9.9.9, 149.112.112.112, 9.9.9.11, 149.112.112.11, 9.9.9.10, 149.112.112.10 }' meta l4proto '{ tcp, udp }' dport 53 dnat to ':9953'
nft add rule inet filter nat_output ip6 daddr '{ 2620:fe::fe, 2620:fe::9, 2620:fe::11, 2620:fe::fe:11, 2620:fe::10, 2620:fe::fe:10 }' meta l4proto '{ tcp, udp }' dport 53 dnat to ':9953'

grow-allow-and-ban-lists.sh

nft add rule inet filter input iifname 'lo' accept
nft add rule inet filter input 'tcp flags != syn / fin,syn,rst,ack' ct state new drop
nft add rule inet filter input ct state invalid drop
nft add rule inet filter input ct state established,related accept
nft add rule inet filter input iifname "${WAN_IFACE}" drop
